	file = {PDF:C\:\\Users\\simsa\\Zotero\\storage\\ST8AVF3P\\Jones et al. - 2017 - A Procedure for Deriving Formulas to Convert Transition Rates to Probabilities for Multistate Markov.pdf:application/pdf},
}

